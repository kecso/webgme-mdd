{
  "mermaidVersionSurveyed": "11.x / 12.x (docs + live examples, Nov 2026)",
  "sources": [
    "https://mermaid.js.org/intro/",
    "https://mermaid.js.org/syntax/all-examples",
    "https://diagramgen.app/mermaid-cheat-sheet/",
    "https://www.drawio.com/docs/manual/mermaid/mermaid-supported-diagram-types/"
  ],
  "webgmeJsonSpec": "https://github.com/deepforge-dev/webgme-json-importer",
  "diagrams": [
    {
      "id": "flowchart",
      "name": "Flowchart",
      "keywords": ["flowchart", "graph"],
      "status": "stable",
      "domains": ["process-modeling", "algorithms", "workflows", "ci-cd", "business-process"],
      "capabilities": [
        "Directed graphs with ranked layout (TD/TB/LR/RL/BT)",
        "Many node shapes (rect, diamond, stadium, cylinder, hexagon, etc.)",
        "Labeled edges, dotted/thick styles, link clicks",
        "Subgraphs / clusters",
        "Styling classes and inline styles"
      ],
      "syntaxHighlights": [
        "flowchart TD",
        "A[Process] --> B{Decision?}",
        "B -->|Yes| C([End])",
        "subgraph id[Title] ... end"
      ],
      "metaConcepts": {
        "Diagram": { "attrs": ["name", "direction", "title"] },
        "Node": { "attrs": ["name", "label", "shape", "styleClass"] },
        "Edge": { "attrs": ["name", "label", "lineStyle", "arrowStyle"], "pointers": ["src", "dst"] },
        "Subgraph": { "attrs": ["name", "label", "direction"], "contains": ["Node", "Edge", "Subgraph"] }
      },
      "sample": "flowchart TD\n  Start([Start]) --> Decide{Ready?}\n  Decide -->|Yes| Work[Do work]\n  Decide -->|No| Start\n  Work --> Done([Done])"
    },
    {
      "id": "sequence",
      "name": "Sequence Diagram",
      "keywords": ["sequenceDiagram"],
      "status": "stable",
      "domains": ["software-interaction", "protocols", "api-design", "uml", "distributed-systems"],
      "capabilities": [
        "Participants and actors with aliases",
        "Sync/async/dashed messages",
        "Activation boxes",
        "Notes, loops, alt/opt/par/critical/break fragments",
        "Autonumber, create/destroy participants"
      ],
      "syntaxHighlights": [
        "sequenceDiagram",
        "participant A as Client",
        "A->>+B: request",
        "B-->>-A: response",
        "alt ok ... else ... end"
      ],
      "metaConcepts": {
        "Diagram": { "attrs": ["name", "autonumber", "title"] },
        "Participant": { "attrs": ["name", "alias", "kind"] },
        "Message": { "attrs": ["name", "label", "arrowType", "activate"], "pointers": ["from", "to"] },
        "Fragment": { "attrs": ["name", "kind", "label"], "contains": ["Message", "Fragment", "Note"] },
        "Note": { "attrs": ["name", "text", "placement"], "pointers": ["overStart", "overEnd"] }
      },
      "sample": "sequenceDiagram\n  actor U as User\n  participant API\n  participant DB\n  U->>+API: GET /items\n  API->>+DB: query\n  DB-->>-API: rows\n  API-->>-U: 200 OK"
    },
    {
      "id": "class",
      "name": "Class Diagram",
      "keywords": ["classDiagram"],
      "status": "stable",
      "domains": ["object-oriented-design", "uml", "software-architecture", "domain-modeling"],
      "capabilities": [
        "Classes with members and methods",
        "Visibility (+/#/-/~), stereotypes, generics",
        "Relationships: inheritance, composition, aggregation, association, dependency, realization",
        "Cardinality annotations",
        "Namespaces / packages"
      ],
      "syntaxHighlights": [
        "classDiagram",
        "class Animal { +String name +eat() }",
        "Animal <|-- Dog",
        "Owner \"1\" --> \"*\" Animal : owns"
      ],
      "metaConcepts": {
        "Diagram": { "attrs": ["name", "title"] },
        "Class": { "attrs": ["name", "stereotype", "isInterface", "isAbstract"] },
        "Member": { "attrs": ["name", "visibility", "type", "classifier"] },
        "Method": { "attrs": ["name", "visibility", "returnType", "parameters", "classifier"] },
        "Relationship": { "attrs": ["name", "kind", "label", "srcCard", "dstCard"], "pointers": ["src", "dst"] },
        "Namespace": { "attrs": ["name"], "contains": ["Class", "Namespace"] }
      },
      "sample": "classDiagram\n  class Animal {\n    +String name\n    +eat()\n  }\n  Animal <|-- Dog\n  Animal <|-- Cat\n  Owner \"1\" --> \"*\" Animal : owns"
    },
    {
